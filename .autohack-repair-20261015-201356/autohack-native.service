[Unit]
Description=AutoHack original autonomous discovery, hunt, review and authenticated submission engine
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
WorkingDirectory=/home/izy/isaiz-bugbounty/autohack
Environment=HOME=/home/izy
Environment=PROJECT_ROOT=/home/izy/isaiz-bugbounty/autohack
Environment=PATH=/home/izy/.local/bin:/home/izy/.npm-global/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/izy/.nvm/versions/node/v22.23.3/bin/npm run dev
Restart=always
RestartSec=30
TimeoutStopSec=30
NoNewPrivileges=true
CPUQuota=75%
MemoryMax=6G
TasksMax=320
[Install]
WantedBy=default.target
