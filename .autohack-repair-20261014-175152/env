AGGREGATOR_ENABLED=true
IMMUNEFI_ENABLED=true
HUNTR_ENABLED=true
SKIP_WEB_ONLY_PROGRAMS=true
SKIP_SIGNAL_REQUIRED=true
SECURITY_MAX_DAILY_HUNTS=3
